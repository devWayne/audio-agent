# Documentation template only: Audio Agent does not auto-load .env files.
# Uncomment/export only settings needed by the actual service process.
# Keep machine-specific copies out of Git.

# AUDIO_AGENT_MODEL=/absolute/path/to/ggml-model.bin
# HANDY_MODELS_DIR=/absolute/path/to/handy-models
# AUDIO_AGENT_THREADS=4
# AUDIO_AGENT_USE_GPU=true
# AUDIO_AGENT_ASR_TIMEOUT=300

# AUDIO_AGENT_SPEAKER_MODELS_DIR=/absolute/path/to/speaker-models
# AUDIO_AGENT_SPEAKER_THREADS=2
# AUDIO_AGENT_SPEAKER_TIMEOUT=300
# AUDIO_AGENT_SPEAKER_CLUSTER_THRESHOLD=0.9

# Default data library is the source project's .data directory.
# AUDIO_AGENT_DATA_DIR=/absolute/path/to/audio-library
# AUDIO_AGENT_FFMPEG=/opt/homebrew/bin/ffmpeg
